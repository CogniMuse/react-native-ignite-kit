{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".", // <- Recommended when using "paths"
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["nativewind/types"] // <- Important for NativeWind support
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "tailwind.config.js",
    "nativewind-env.d.ts",
    "app/index.jsx"
  ]
}
